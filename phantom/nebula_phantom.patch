 !   Gammie (2001) cooling
 !+
 !-----------------------------------------------------------------------
+subroutine nebula_cooling(xi,yi,zi,ui,rhoi,dt,dudti)
+!  nebula: our physics/cooling.py beta_cool over one step dt:
+!     u_new = u_floor + (u - u_floor) exp(-dt/t_cool),  t_cool = beta/Omega, Omega = r^-3/2
+!  u_floor = 3 k T/(2 mu m_p) + a T^4/rho at T = nebula_tfloor (our physics/eos.py gasrad_u_si)
+ use externalforces, only:mass1
+ use physcon,        only:kboltz,mass_proton_cgs,radconst
+ use units,          only:unit_density,unit_ergg
+ use eos,            only:gmw
+ real, intent(in)    :: xi,yi,zi,ui,rhoi,dt
+ real, intent(inout) :: dudti
+ real :: r2,tcool,uf,unew
+
+ r2    = xi*xi + yi*yi + zi*zi
+ tcool = beta_cool/(sqrt(mass1)*r2**(-0.75))
+ uf    = (1.5*kboltz*nebula_tfloor/(gmw*mass_proton_cgs) &
+          + radconst*nebula_tfloor**4/(rhoi*unit_density))/unit_ergg
+ if (dt > 0.) then
+    unew  = uf + (ui - uf)*exp(-dt/tcool)
+    dudti = dudti + (unew - ui)/dt
+ else
+    dudti = dudti - (ui - uf)/tcool
+ endif
+
+end subroutine nebula_cooling
