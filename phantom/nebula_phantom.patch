+pure subroutine nebula_fallback(rhosum,nneighi,denom,rmatrix)
+!  nebula: our sim/sph.py _near_singular (DECISIONS D11): with fewer than 4 neighbours, a
+!  non-positive tr R or |det R| < 1e-6 (tr R/3)^3, use G/(tr R/3) (0 if tr R <= 0). Done by
+!  replacing R^-1 = cofactor/det with (scale^2 I)/scale^3 so exactlinear returns dA/scale.
+ real,    intent(in)    :: rhosum(:)
+ integer, intent(in)    :: nneighi
+ real,    intent(inout) :: denom,rmatrix(6)
+ real :: scale
+ scale = (rhosum(irxxi) + rhosum(iryyi) + rhosum(irzzi))/3.
+ if (nneighi < 4 .or. .not.(scale > 0.) .or. .not.(abs(denom) >= 1.e-6*scale**3)) then
+    if (scale > 0.) then
+       rmatrix = (/scale**2,0.,0.,scale**2,0.,scale**2/)
+       denom = scale**3
+    else
+       rmatrix = 0.
+       denom = 1.
+    endif
+ endif
+end subroutine nebula_fallback
+
+pure subroutine nebula_divcurl(rhosum,denom,rmatrix,divcurlvi,ndivcurlv)
+!  nebula: div v and curl v from the corrected gradient (our sim/sph.py _gradients_kernel)
+ real,    intent(in)    :: rhosum(:),denom,rmatrix(6)
+ integer, intent(in)    :: ndivcurlv
+ real,    intent(inout) :: divcurlvi(5)
+ real :: gx(3),gy(3),gz(3),dd
+ if (abs(denom) <= tiny(denom)) return
+ dd = 1./denom
+ call exactlinear(gx(1),gx(2),gx(3),rhosum(idvxdxi),rhosum(idvxdyi),rhosum(idvxdzi),rmatrix,dd)
+ call exactlinear(gy(1),gy(2),gy(3),rhosum(idvydxi),rhosum(idvydyi),rhosum(idvydzi),rmatrix,dd)
+ call exactlinear(gz(1),gz(2),gz(3),rhosum(idvzdxi),rhosum(idvzdyi),rhosum(idvzdzi),rmatrix,dd)
+ ! dv_i/dx_j = -g_i(j) (sign as in calculate_strain_from_sums)
+ divcurlvi(1) = -(gx(1) + gy(2) + gz(3))
+ if (ndivcurlv >= 4) then
+    divcurlvi(2) = -(gz(2) - gy(3))
+    divcurlvi(3) = -(gx(3) - gz(1))
+    divcurlvi(4) = -(gy(1) - gx(2))
+ endif
