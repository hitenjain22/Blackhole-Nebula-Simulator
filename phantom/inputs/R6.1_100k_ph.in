# Runtime options file for Phantom, written 04/11/2026 03:44:07.5
# Options not present assume their default values
# This file is updated automatically after a full dump

# job name
             logfile =  cloud08.log   ! file to which output is directed
            dumpfile =  main100k_00000.tmp

# options controlling run time and input/output
                tmax =   3.800E+06    ! end time
               dtmax =       2048    ! time between dumps
                nmax =          -1    ! maximum number of timesteps (0=just get derivs and stop)
                nout =          -1    ! write dumpfile every n dtmax (-ve=ignore)
            twallmax =      000:00    ! maximum wall time (hhh:mm, 000:00=ignore)
           nfulldump =           1    ! full dump every n dumps
            iverbose =           0    ! verboseness of log (-1=quiet 0=default 1=allsteps 2=debug 5=max)
           dtwallmax =      024:00    ! maximum wall time between dumps (hhh:mm, 000:00=ignore)

# options controlling accuracy
              C_cour =       0.300    ! Courant factor
             C_force =       0.250    ! dt_force factor
                tolv =   1.000E-02    ! tolerance on v iterations in timestepping (>= 100 to skip)
               hfact =       1.600    ! h in units of particle spacing [h = hfact*n^(-1/3)]
                tolh =   1.000E-04    ! tolerance on h-n iterations
         nebula_hmax =        200.    ! nebula: cap on h, Omega = 1 at the cap (0=off)

# shock capturing
               alpha =       0.000    ! MINIMUM shock viscosity parameter
            alphamax =       1.000    ! MAXIMUM shock viscosity parameter
                beta =       2.000    ! non-linear shock viscosity parameter
              alphau =       0.050    ! shock conductivity parameter
        nebula_recon =           1    ! nebula: reconstructed jump in shock viscosity (0=off,1=on)

# options controlling equation of state
                ieos =          12    ! eqn of state (1=isoth;2=adiab;3=locally iso;8=barotropic)
                  mu =       0.600    ! mean molecular weight
        ipdv_heating =           1    ! heating from PdV work (0=off, 1=on)
      ishock_heating =           1    ! shock heating (0=off, 1=on)

# options controlling cooling
            icooling =           3    ! cooling function (0=off, 1=library (step), 2=library (force),3=Gammie, 4=ISM, 5,6=KI02, 7=powerlaw, 9=radiative approx)
              C_cool =       0.050    ! factor controlling cooling timestep
           beta_cool =        230.    ! beta factor in Gammie (2001) cooling
              Tfloor =       0.0    ! (nebula_cool floor instead)

# options relating to external forces
      iexternalforce =          12    ! 1=star,2=coro,3=bina,4=prdr,5=toru,6=toys,7=exte,8=spir,9=Lens,10=dens,11=Eins,
               mass1 =       1.000    ! mass of central object in code units
          accradius1 =       4.000    ! soft accretion radius of central object
     accradius1_hard =       4.000    ! hard accretion radius of central object
              orbfac =       0.040    ! nebula: dt <= C_force*orbfac*r^1.5 (0=off)
            eps_soft =       0.000    ! softening length (Plummer) for central potential in code units

# options controlling physical viscosity
           irealvisc =           0    ! physical viscosity type (0=none,1=const,2=Shakura/Sunyaev)
          shearparam =       0.100    ! magnitude of shear viscosity (irealvisc=1) or alpha_SS (irealvisc=2)
            bulkvisc =       0.000    ! magnitude of bulk viscosity

# options for injecting/removing particles
               rkill =   5.000E+04    ! deactivate particles outside this radius (<0 is off)

# optional outputs
               curlv =           F    ! output curl v in dump files
           track_lum =           F    ! write du/dt to dump files (for a "lightcurve")
                  gw =           F    ! calculate gravitational wave strain
        nebula_cond =           1
         nebula_grad =           T
       nebula_gamma1 =           T
         nebula_cool =           T
       nebula_tfloor =   1.000E+04
